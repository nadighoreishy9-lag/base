#!/bin/sh
# این اسکریپت در پایان آماده‌سازیِ docker-entrypoint.sh تصویر رسمی اجرا می‌شود. نامش عمداً با
# «apache2» شروع می‌شود تا گاردِ آن اسکریپت، کپی هسته و ساخت wp-config.php را انجام دهد.
# ابتدا صفحات المنتور ساخته/به‌روزرسانی می‌شوند و بعد وب‌سرور در پیش‌زمینه بالا می‌آید.
set -eu

/bin/sh /source/bin/bootstrap.sh

exec apache2-foreground
